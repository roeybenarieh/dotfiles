    containBar = false;
    enableFirefoxPlayer = false;
    frameEnabled = false;
    frameThickness = 8;
    hoverRegionHeight = 8;
    hoverToReveal = true;
    keepBarBorder = false;
    keepBarShadow = false;
    launcherIcon = "";
